        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="Write_To_CSV">
          <stringProp name="TestPlan.comments">запись данных в CSV</stringProp>
          <stringProp name="BeanShellSampler.query">import java.io.FileWriter;
import java.io.PrintWriter;
import java.text.SimpleDateFormat;
import java.util.Date;

String file = &quot;/tmp/jmeter_results.csv&quot;;

PrintWriter out = new PrintWriter(new FileWriter(file, true));

String timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date());
String userId = vars.get(&quot;userId&quot;);
String cartId = vars.get(&quot;cartId&quot;);

out.println(timestamp + &quot;,&quot; + userId + &quot;,&quot; + cartId);

out.close();</stringProp>
        </BeanShellSampler>
