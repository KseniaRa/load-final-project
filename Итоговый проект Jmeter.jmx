          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare_Search_Query" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def queries = [&apos;phone&apos;, &apos;laptop&apos;, &apos;watch&apos;, &apos;shirt&apos;, &apos;tablet&apos;]
def query = queries[new Random().nextInt(queries.size())]

vars.put(&apos;searchQuery&apos;, query)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">поисковые запросы</stringProp>
          </JSR223PreProcessor>
